# HokiePath environment variables (Section 13 of the spec).
# Copy to .env.local for local dev; add the same keys in Vercel -> Settings -> Environment Variables
# (Production + Preview). Never commit real values. Human setup steps: docs/integrations/*.md.

# ---- Auth.js + Google OAuth (spec 12.1) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Empty = any Google account. Comma-separated to restrict, e.g. vt.edu
ALLOWED_EMAIL_DOMAINS=
# Comma-separated emails that can see /admin
ADMIN_EMAILS=

# ---- Databricks workspace (spec 11.1-11.5) ----
# Workspace URL, no trailing slash, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# Personal access token (11.4). Server-side only.
DATABRICKS_TOKEN=
# SQL Warehouse -> Connection details -> last segment of the HTTP path (11.3)
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=hokiepath
# Serving page endpoint names (11.5). Verify in your workspace; do not guess.
DATABRICKS_LLM_ENDPOINT=
DATABRICKS_EMBEDDING_ENDPOINT=

# ---- Vector Search (11.7), optional: search falls back to SQL ILIKE ----
DATABRICKS_VS_EVENTS_INDEX=
DATABRICKS_VS_OPPS_INDEX=

# ---- Genie (11.10), optional ----
DATABRICKS_GENIE_SPACE_ID=

# ---- Lakebase Postgres (11.8) ----
LAKEBASE_HOST=
LAKEBASE_DB=databricks_postgres
LAKEBASE_USER=
# Endpoint resource name used to mint short-lived Postgres credentials (option a).
# Format: projects/<project_id>/branches/<branch_id>/endpoints/<endpoint_id>
# Find it with: GET /api/2.0/postgres/projects and .../branches/<branch>/endpoints
LAKEBASE_ENDPOINT=
# Only if the project has native Postgres login enabled and you created a role (option b).
# When set, it is used as-is and no credential is generated.
LAKEBASE_PASSWORD=

# ---- App ----
# Published AI/BI dashboard link (11.11), shown on /admin
NEXT_PUBLIC_AIBI_DASHBOARD_URL=
# true = serve fixtures/demo/*.json instead of live Databricks (14.4)
DEMO_MODE=false
# Protects /api/cron/* if ingestion falls back to Vercel Cron (11.9)
CRON_SECRET=

# ---- Databricks secret scope "hokiepath" (NOT env vars; set with the Databricks CLI, 11.9) ----
# onet_key, bls_key
